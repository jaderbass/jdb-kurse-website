			"\t\t\t\techo '<p>Es wurden ' . \\$stmt->rowCount() . ' Datensätze geändert.</p>';",
			"\t\t\t}",
			"\t\t}",
			"\t} catch (PDOException \\$e) {",
			"\t\techo get_db_error(\\$pdo, \\$sql, \\$e);",
			"\t}",
			"}",
			"\t\\$stmt = NULL;",
			"\t\\$pdo = NULL;"
		],
		"description": "PDO UPDATE mit Prepared Statements"
	},
